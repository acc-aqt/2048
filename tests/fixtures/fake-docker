#!/usr/bin/env python3
import json
import os
import sys
import time

if sys.argv[1:2] == ["kill"]:
    kills_file = os.environ.get("FAKE_DOCKER_KILLS")
    if kills_file:
        with open(kills_file, "a") as f:
            f.write(json.dumps(sys.argv[1:]) + "\n")
    sys.exit(0)

args_file = os.environ.get("FAKE_DOCKER_ARGS")
if args_file:
    with open(args_file, "w") as f:
        json.dump(sys.argv[1:], f)
time.sleep(float(os.environ.get("FAKE_DOCKER_SLEEP", "0")))
sys.stdout.write(os.environ.get("FAKE_DOCKER_STDOUT", ""))
sys.stderr.write(os.environ.get("FAKE_DOCKER_STDERR", ""))
sys.exit(int(os.environ.get("FAKE_DOCKER_EXIT", "0")))
