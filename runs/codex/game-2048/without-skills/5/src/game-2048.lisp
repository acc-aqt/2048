(in-package :game-2048)

(defun slide-row (row)
  "Slide ROW toward its first element, returning the new row and score."
  (let* ((tiles (remove 0 row))
         (result nil)
         (score 0))
    (loop while tiles do
      (let ((first (pop tiles)))
        (if (and tiles (= first (car tiles)))
            (let ((merged (* 2 first)))
              (pop tiles)
              (push merged result)
              (incf score merged))
            (push first result))))
    (let ((merged-count (length result)))
      (values (nconc (nreverse result)
                     (make-list (- 4 merged-count) :initial-element 0))
              score))))

(defun copy-board (board)
  (let ((copy (make-array '(4 4) :initial-element 0)))
    (dotimes (row 4 copy)
      (dotimes (column 4)
        (setf (aref copy row column) (aref board row column))))))

(defun move (board direction)
  (unless (member direction '(:left :right :up :down))
    (error "Invalid direction: ~S" direction))
  (let ((result (make-array '(4 4) :initial-element 0))
        (score 0))
    (dotimes (line 4)
      (let ((cells (loop for offset below 4
                         collect (if (member direction '(:left :right))
                                     (aref board line offset)
                                     (aref board offset line)))))
        (when (member direction '(:right :down))
          (setf cells (reverse cells)))
        (multiple-value-bind (slid gained) (slide-row cells)
          (incf score gained)
          (when (member direction '(:right :down))
            (setf slid (reverse slid)))
          (dotimes (offset 4)
            (if (member direction '(:left :right))
                (setf (aref result line offset) (nth offset slid))
                (setf (aref result offset line) (nth offset slid)))))))
    (values result score (not (equalp board result)))))

(defun spawn-tile (board random-state)
  (let* ((result (copy-board board))
         (empty (loop for row below 4
                      append (loop for column below 4
                                   when (zerop (aref board row column))
                                     collect (cons row column))))
         (cell (nth (random (length empty) random-state) empty))
         (value (if (zerop (random 10 random-state)) 4 2)))
    (setf (aref result (car cell) (cdr cell)) value)
    result))

(defun won-p (board)
  (loop for row below 4
        thereis (loop for column below 4
                      thereis (= (aref board row column) 2048))))

(defun game-over-p (board)
  (loop for direction in '(:left :right :up :down)
        never (nth-value 2 (move board direction))))

(defun print-board (board score output)
  (format output "Score: ~D~%" score)
  (dotimes (row 4)
    (dotimes (column 4)
      (if (zerop (aref board row column))
          (format output "~6A" ".")
          (format output "~6D" (aref board row column))))
    (terpri output))
  (terpri output))

(defun play (&key (input *standard-input*) (output *standard-output*)
                  (random-state (make-random-state t)))
  (let ((board (make-array '(4 4) :initial-element 0))
        (score 0)
        (announced-win nil))
    (setf board (spawn-tile board random-state)
          board (spawn-tile board random-state))
    (loop
      (print-board board score output)
      (when (game-over-p board)
        (format output "Game over.~%")
        (return))
      (let ((line (read-line input nil nil)))
        (when (or (null line) (string-equal line "q"))
          (return))
        (let ((direction (cond ((string-equal line "w") :up)
                               ((string-equal line "a") :left)
                               ((string-equal line "s") :down)
                               ((string-equal line "d") :right)
                               (t nil))))
          (when direction
            (multiple-value-bind (moved gained changed) (move board direction)
              (when changed
                (setf board (spawn-tile moved random-state))
                (incf score gained)
                (when (and (not announced-win) (won-p board))
                  (format output "You won!~%")
                  (setf announced-win t)))))))))
  (values))
