(eval-when (:compile-toplevel :load-toplevel :execute)
  (require :tester))

(defpackage :game-2048-tests
  (:use :common-lisp :util.test :game-2048))

(in-package :game-2048-tests)

(with-tests ()
  (multiple-value-bind (row score) (slide-row '(2 2 2 2))
    (test (equal row '(4 4 0 0)) "row result")
    (test (= score 8) "score"))
  (multiple-value-bind (row score) (slide-row '(2 2 2 0))
    (test (equal row '(4 2 0 0)) "three tiles")
    (test (= score 4) "three tile score"))
  (multiple-value-bind (row score) (slide-row '(0 2 0 2))
    (test (equal row '(4 0 0 0)) "skip zeros")
    (test (= score 4) "zero row score"))
  (let ((board (make-array '(4 4) :initial-element 0)))
    (setf (aref board 0 0) 2 (aref board 0 1) 2)
    (multiple-value-bind (result score changed) (move board :left)
      (test changed "move changed")
      (test (= score 4) "move score")
      (test (= 4 (aref result 0 0)) "move placement")
      (test (= 2 (aref board 0 0)) "input kept")))
  (let* ((board (make-array '(4 4) :initial-element 0))
         (state-a (make-random-state t))
         (state-b (make-random-state state-a))
         (result-a (spawn-tile board state-a))
         (result-b (spawn-tile board state-b)))
    (test (equalp result-a result-b) "repeatable spawn")
    (test (= 1 (loop for row below 4 sum
                       (loop for column below 4 count
                             (not (zerop (aref result-a row column)))))) "spawn count"))
  (let ((board (make-array '(4 4) :initial-element 0)))
    (test (not (won-p board)) "not won")
    (test (not (game-over-p board)) "not over")
    (setf (aref board 0 0) 2048)
    (test (won-p board) "won"))
  (let ((input (make-string-input-stream (format nil "x~%q~%")))
        (output (make-string-output-stream)))
    (play :input input :output output :random-state (make-random-state t))
    (test (search "Invalid key." (get-output-stream-string output)) "invalid key output")))
